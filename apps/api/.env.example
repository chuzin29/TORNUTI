# ============================================================
# Tornuti API - variables de entorno
# Copia este archivo a .env y completa los valores reales.
# ============================================================

# PostgreSQL. Neon, Supabase o un Postgres local con Docker.
# Neon: panel del proyecto -> Connection string.
DATABASE_URL="postgresql://tornuti:tornuti@localhost:5432/tornuti?schema=public"
DIRECT_URL="postgresql://tornuti:tornuti@localhost:5432/tornuti?schema=public"

# Secreto para firmar los JWT. Genera uno con:
# openssl rand -base64 48
JWT_SECRET="cambia-esto-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="7d"

# Origenes permitidos por CORS, separados por coma.
CORS_ORIGIN="http://localhost:3000"

PORT=3001
NODE_ENV="development"
