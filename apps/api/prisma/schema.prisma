generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLAYER
  ORGANIZER
  ADMIN
}

enum TournamentStatus {
  DRAFT
  PUBLISHED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
  GROUPS_THEN_PLAYOFF
  SWISS
}

enum RegistrationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AuraReason {
  REGISTRATION
  MATCH_PLAYED
  MATCH_WIN
  PODIUM
  ORGANIZER
  ACHIEVEMENT
  ADJUSTMENT
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  handle       String   @unique
  bio          String?
  avatarUrl    String?
  role         Role     @default(PLAYER)
  aura         Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedTournaments Tournament[]           @relation("TournamentOrganizer")
  teamsCreated         Team[]                 @relation("TeamCreator")
  teamMemberships      TeamMember[]
  registrations        TournamentRegistration[]
  auraTransactions     AuraTransaction[]
  achievements         Achievement[]
  statistics           PlayerStatistics?
  reportsMade          Report[]                @relation("ReportReporter")
  reportsReceived      Report[]                @relation("ReportReported")

  @@index([aura])
}

model Team {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  motto       String?
  description String?
  logoUrl     String?
  category    String
  city        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  creator     User                     @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     TeamMember[]
  registrations TournamentRegistration[]
  matchesAsTeam1 Match[]                @relation("MatchTeam1")
  matchesAsTeam2 Match[]                @relation("MatchTeam2")
  matchesWon  Match[]                   @relation("MatchWinner")
  statistics  TeamStatistics?
  groupEntries GroupParticipant[]

  @@index([category])
}

model TeamMember {
  id       String   @id @default(cuid())
  userId   String
  teamId   String
  role     String   @default("member")
  joinedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
}

model Tournament {
  id                 String           @id @default(cuid())
  slug               String           @unique
  name               String
  summary            String?
  description        String
  category           String
  sport              String?
  format             TournamentFormat @default(SINGLE_ELIMINATION)
  status             TournamentStatus @default(DRAFT)
  location           String
  city               String
  startsAt           DateTime
  registrationEndsAt DateTime
  maxParticipants    Int
  auraPrize          Int              @default(0)
  rules              String[]         @default([])
  cover              String           @default("court")
  organizerId        String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  organizer     User                     @relation("TournamentOrganizer", fields: [organizerId], references: [id], onDelete: Cascade)
  registrations TournamentRegistration[]
  matches       Match[]
  groups        TournamentGroup[]

  @@index([status, startsAt])
  @@index([category])
}

model TournamentRegistration {
  id           String             @id @default(cuid())
  tournamentId String
  userId       String
  teamId       String?
  status       RegistrationStatus @default(PENDING)
  seed         Int?
  createdAt    DateTime           @default(now())

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  team       Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, userId])
  @@index([tournamentId, status])
}

model Match {
  id           String      @id @default(cuid())
  tournamentId String
  round        Int
  position     Int
  stage        String
  team1Id      String?
  team2Id      String?
  winnerId     String?
  score1       Int?
  score2       Int?
  scheduledAt  DateTime?
  status       MatchStatus @default(SCHEDULED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  tournament Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team1      Team?      @relation("MatchTeam1", fields: [team1Id], references: [id], onDelete: SetNull)
  team2      Team?      @relation("MatchTeam2", fields: [team2Id], references: [id], onDelete: SetNull)
  winner     Team?      @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, round, position])
  @@index([tournamentId, status])
}

model TournamentGroup {
  id           String   @id @default(cuid())
  tournamentId String
  name         String
  createdAt    DateTime @default(now())

  tournament   Tournament         @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  participants GroupParticipant[]

  @@unique([tournamentId, name])
}

model GroupParticipant {
  id      String @id @default(cuid())
  groupId String
  teamId  String
  seed    Int?
  status  String @default("qualified")

  group TournamentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  team  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([groupId, teamId])
}

model PlayerStatistics {
  id         String   @id @default(cuid())
  userId     String   @unique
  matches    Int      @default(0)
  wins       Int      @default(0)
  losses     Int      @default(0)
  draws      Int      @default(0)
  points     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeamStatistics {
  id        String   @id @default(cuid())
  teamId    String   @unique
  matches   Int      @default(0)
  wins      Int      @default(0)
  losses    Int      @default(0)
  draws     Int      @default(0)
  points    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model AuraTransaction {
  id           String     @id @default(cuid())
  userId       String
  amount       Int
  reason       AuraReason
  description  String
  tournamentId String?
  matchId      String?
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Achievement {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  criteria    String
  rewardAura  Int      @default(0)
  category    String
  createdAt   DateTime @default(now())

  recipients User[]
}

model Report {
  id           String    @id @default(cuid())
  reporterId   String
  reportedId   String
  tournamentId String?
  matchId      String?
  type         String
  details      String?
  status       String    @default("pending")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?

  reporter User @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportReported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([status])
}
