{
  "name": "tornuti",
  "version": "0.1.0",
  "private": true,
  "description": "Tornuti - Plataforma universal de torneos con sistema de gamificación Aura",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web",
    "db:generate": "npm run db:generate --workspace=apps/api",
    "db:push": "npm run db:push --workspace=apps/api"
  },
  "engines": {
    "node": ">=18"
  }
}